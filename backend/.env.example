PORT=8080
# Local (docker compose):  postgres://geotrack:geotrack@localhost:5432/geotrack
# AWS RDS:                 postgres://USUARIO:CLAVE@xxxx.rds.amazonaws.com:5432/geotrack
DATABASE_URL=postgres://geotrack:geotrack@localhost:5432/geotrack
DB_SSL=false
# Clave que envía la app móvil en el header x-api-key
DEVICE_API_KEY=dev-device-key
# Token para entrar al dashboard web
DASHBOARD_TOKEN=dev-dashboard-token
# Segundos sin datos para considerar un dispositivo "sin señal"
OFFLINE_AFTER_SEC=120
